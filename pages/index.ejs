      <div class="section__container header__container" style="background-image: url('../assets/02.jpg'); background-size: cover; overflow: visible";>
        <div class="header__content">
          <h1>Providing an Exceptional Patient Experience</h1>
          <p>
            Welcome, where exceptional patient experiences are our priority.
            With compassionate care, state-of-the-art facilities, and a
            patient-centered approach, we're dedicated to your well-being. Trust
            us with your health and experience the difference.
          </p>
          <button class="serve_btn";><a href="/services" style="color: aliceblue";>See Services</a></button>
        </div>
        <div class="header__form">
          <form action="/submit_form" method="post" id="appointmentForm">

            <!-- STEP 1 -->

            <div class="form-step active" id="step1">

              <h4>Book Appointment</h4>

              <input
                type="text"
                name="name"
                placeholder="Full Name"
                required
              >

              <input
                type="tel"
                name="phoneNumber"
                placeholder="Phone Number"
                required
              >

              <input
                type="email"
                name="email"
                placeholder="Email Address"
                required
              >

              <select
                name="condition"
                required
              >
                <option value="">
                  Primary Concern
                </option>

                <option>Chronic Back Pain</option>
                <option>Arthritis</option>
                <option>Stroke Rehabilitation</option>
                <option>Knee Pain</option>
                <option>Frozen Shoulder</option>
                <option>Post Accident Rehabilitation</option>
                <option>Book Consultation</option>
              </select>

              <label for="preferredDate" class="form-label">
                Preferred Appointment Date
              </label>

              <input
                type="date"
                name="preferredDate"
                required
              >

              <button
                type="button"
                class="btn form__btn"
                id="nextStep"
              >
                Continue →
              </button>

            </div>

            <!-- STEP 2 -->

            <div class="form-step" id="step2">

              <h4>Consultation Details</h4>

              <textarea
                name="painDescription"
                placeholder="Describe your pain or condition"
              ></textarea>

              <select name="treatment">

                <option value="">
                  Preferred Treatment
                </option>

                <option>Kinesio Taping</option>
                <option>Myofascial Release</option>
                <option>Sports Massage</option>
                <option>Dry Needling</option>
                <option>Cupping Therapy</option>
                <option>Electro Therapy</option>
                <option>Book Consultation</option>

              </select>

              <label for="preferredDate" class="form-label">
                Preferred Appointment Time
              </label>

              <input
                type="time"
                name="preferredTime"
              >

              <textarea
                name="additionalNotes"
                placeholder="Additional Notes"
              ></textarea>

              <!-- Honeypot -->

              <div
                class="cf-turnstile"
                data-sitekey="0x4AAAAAADiF7jG8jpwYkdZ-">
              </div>

              <input
                type="text"
                name="website"
                autocomplete="off"
                tabindex="-1"
                style="display:none"
              >

              <input
                type="hidden"
                id="formLoadedAt"
                name="formLoadedAt"
              >

              <div class="form-navigation">

                <button
                  type="button"
                  class="btn"
                  id="prevStep"
                >
                  ← Back
                </button>

                <button
                  type="submit"
                  class="btn form__btn"
                >
                  Submit
                </button>

              </div>

            </div>

          </form>    
        </div>
      </div>

