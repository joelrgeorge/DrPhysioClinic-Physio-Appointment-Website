<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="assets/favicon.png">
    <title>About Us</title>
</head>

<style>
.doctors__card__image {
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: 12px;
}

.doctors__card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
</style>

<body>
    <!-- Google Tag Manager (noscript) -->
        <noscript>
            <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NQPNQS2C"
                height="0" width="0" style="display:none;visibility:hidden">
            </iframe>
        </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <header>
        <!-- Include the header -->
        <%- include('../components/header') %>
    </header>

    <section>
        <!-- Banner Photo with Text -->
        <div class="banner">
            <div class="banner-text">
                <h2>About <b style="color: #fb923c;"> Us</b> - What <b style="color: #fb923c;">We</b> Do?</h2>
                <p>We at <b style="color: #fb923c;">Dr. Physio Clinic</b> Deliver a wide range of Physiotherapy services within a nurturing and encouraging atmosphere, 
                    led by committed professionals who advocate for independence. Rest assured that your personalized care plan will be 
                    diligently administered.
                </p>
            </div>
        </div>
    </section>

    <section class="section__container doctors__container" style="background-color: white;">
      <div class="doctors__header">
        <div class="doctors__header__content">
          <h2 class="section__header">
            <b style="color: #fb923c;">Our</b> Special Doctors
          </h2>
          <p>
            We take pride in our exceptional team of doctors, each a specialist
            in their respective fields.
          </p>
        </div>

        <div class="doctors__nav">
          <span><i class="ri-arrow-left-line"></i></span>
          <span><i class="ri-arrow-right-line"></i></span>
        </div>
      </div>

      <div class="doctors__grid">

        <!-- Doctor 1 -->
        <div class="doctors__card">
          <div class="doctors__card__image">
            <img src="https://ik.imagekit.io/liegedevs/assets/DSC02948.webp?tr=w-600,q-80"
            loading="lazy"
            decoding="async"
            alt="doctor"/>
            <div class="doctors__socials">
              <a href="https://www.instagram.com/physiotherapist_dr_prince?igsh=MXJ2dzZ6OWU3MTYycw%3D%3D&utm_source=qr"
                target="_blank"
                rel="noopener noreferrer"
                style="color: white; text-decoration: none;">
                <span><i class="ri-instagram-line"></i></span>
              </a>

              <span><i class="ri-facebook-fill"></i></span>
              <span><i class="ri-heart-fill"></i></span>
              <span><i class="ri-twitter-fill"></i></span>
            </div>
          </div>

          <h4>Prince Jacob Mathew</h4>
          <p>Chief Physiotherapist</p>
        </div>

        <!-- Doctor 2 -->
