<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Thank You | Dr Physio Clinic</title>

  <link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/thankyou.css"
  >

</head>

<body>

  <div class="card">
    <div class="hero">
      <img
        src="/assets/logo.png"
        alt="Dr Physio Clinic"
        class="logo"
      >

      <h1>
        <%= pageTitle %>
      </h1>

      <p>
        Thank you for choosing Dr Physio Clinic.
      </p>

    </div>

    <div class="content">
      <div class="success-icon">
        <i class="ri-checkbox-circle-fill"></i>
      </div>

      <h2>
        Thank You, <%= name %>!
      </h2>

      <p class="description">
        <%= message %>
      </p>

      <div class="info-box">
        <h3>
          What Happens Next?
        </h3>

        <ul>
          <li>
            <i class="ri-phone-line"></i>
            A member of our team will contact you shortly.
          </li>

          <li>
            <i class="ri-calendar-check-line"></i>
            We'll review your enquiry and confirm next steps.
          </li>

          <li>
            <i class="ri-heart-pulse-line"></i>
            Our team is committed to helping you recover and thrive.
          </li>
        </ul>

      </div>

      <a
        href="/"
        class="btn"
      >
        Return to Homepage
      </a>

    </div>

    <div class="footer">
      <div class="clinic">
        Dr Physio Clinic
      </div>

      <div class="divider"></div>
      Helping You Move Better,
      Feel Better & Live Better
      <br><br>
      Designed & Developed by
      <span class="agency">
        Liege Technologies
      </span>
    </div>
  </div>

</body>
</html>